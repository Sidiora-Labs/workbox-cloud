{
  "$schema": "https://openship.io/app.schema.json",
  "id": "webtop",
  "name": "Webtop",
  "description": "An XFCE desktop and Chromium browser on your server, with persistent files and password-protected access.",
  "kind": "template",
  "logo": "webtop",
  "category": "browser",
  "available": true,
  "verified": false,
  "schemaVersion": 2,
  "minEngine": "0.9.2",
  "supportsCloud": false,
  "framework": "docker-compose",
  "repository": "https://github.com/linuxserver/docker-webtop",
  "provenance": {
    "source": "upstream",
    "url": "https://docs.linuxserver.io/images/docker-webtop/",
    "revision": "0c46c80a-ls325",
    "license": "GPL-3.0-only (container packaging); bundled components retain their own licenses",
    "reviewedAt": "2026-11-17"
  },
  "minResources": {
    "cpuCores": 2,
    "memoryMb": 3072
  },
  "tags": [
    "browser",
    "desktop",
    "private",
    "selkies",
    "interactive"
  ],
  "services": [
    {
      "name": "webtop",
      "image": "docker.io/linuxserver/webtop:0c46c80a-ls325@sha256:211570631c76df794bc2beb451cefdba225a58643be396cc911cef205a0db7a5",
      "shmSize": 1073741824,
      "restart": "unless-stopped",
      "environment": {
        "PUID": "1000",
        "PGID": "1000",
        "TZ": "Etc/UTC",
        "HARDEN_DESKTOP": "true",
        "SELKIES_ENABLE_SHARING": "false|locked",
        "SELKIES_ENABLE_SHARED": "false|locked",
        "AUTO_GPU": "false",
        "NO_GAMEPAD": "true",
        "NO_WEBCAM": "true"
      },
      "volumes": [
        "webtop_config:/config"
      ],
      "resources": {
        "cpuCores": 1,
        "memoryMb": 2048,
        "diskMb": 4096
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "curl -fsS -o /dev/null http://127.0.0.1:3000/"
        ],
        "interval": "15s",
        "timeout": "5s",
        "retries": 12,
        "startPeriod": "60s"
      }
    },
    {
      "name": "webtop-access",
      "image": "caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5",
      "restart": "unless-stopped",
      "dependsOn": [
        "webtop"
      ],
      "secretEnv": [
        "OPENSHIP_ADMIN_PASSWORD"
      ],
      "commandArgv": [
        "sh",
        "/etc/workbox/access.sh"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget -S -O /dev/null http://127.0.0.1:8080/ 2>&1 | grep -q '401 Unauthorized'"
        ],
        "interval": "15s",
        "timeout": "5s",
        "retries": 8
      },
      "exposed": true,
      "exposedPort": 8080,
      "routes": [
        {
          "port": 8080
        }
      ],
      "resources": {
        "cpuCores": 0.25,
        "memoryMb": 128,
        "diskMb": 128
      }
    }
  ],
  "configFields": [
    {
      "service": "webtop-access",
      "key": "OPENSHIP_ADMIN_USER",
      "label": "Access username",
      "default": "workbox",
      "required": true
    },
    {
      "service": "webtop-access",
      "key": "OPENSHIP_ADMIN_PASSWORD",
      "label": "Access password",
      "generate": "secret",
      "secret": true
    }
  ],
  "settings": [
    {
      "id": "access",
      "label": "Browser access",
      "columns": 2,
      "fields": [
        {
          "service": "webtop-access",
          "key": "OPENSHIP_ADMIN_USER",
          "label": "Access username",
          "type": "text",
          "default": "workbox",
          "required": true,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "patternError": "Use letters, numbers, dots, dashes or underscores.",
          "installStep": true,
          "requiresRedeploy": true
        },
        {
          "service": "webtop-access",
          "key": "OPENSHIP_ADMIN_PASSWORD",
          "label": "Access password",
          "type": "password",
          "secret": true,
          "required": true,
          "requiresRedeploy": true,
          "help": "Generated during installation. Keep the password private."
        }
      ]
    },
    {
      "id": "browser",
      "label": "Browser preferences",
      "fields": [
        {
          "service": "webtop",
          "key": "TZ",
          "label": "Timezone",
          "type": "text",
          "default": "Etc/UTC",
          "installStep": true,
          "requiresRedeploy": true
        }
      ]
    }
  ],
  "management": {
    "kind": "schema"
  },
  "endpoints": [
    {
      "service": "webtop-access",
      "port": 8080,
      "label": "Private desktop",
      "kind": "http",
      "scope": "internal",
      "defaultMode": "internal",
      "allowedModes": [
        "internal",
        "domain"
      ]
    }
  ],
  "connection": {
    "title": "Open Webtop",
    "description": "Connect through the protected gateway using the generated credentials. Browser profiles are stored on a project-scoped volume.",
    "guide": {
      "defaultMode": "internal",
      "intro": "This is an interactive Linux desktop. Open its gateway through a local tunnel, or explicitly assign a HTTPS domain."
    },
    "outputs": [
      {
        "id": "url",
        "label": "Webtop",
        "source": "publicUrl:webtop-access",
        "kind": "url",
        "recommended": true
      },
      {
        "id": "username",
        "label": "Username",
        "source": "env:webtop-access:OPENSHIP_ADMIN_USER",
        "width": "half"
      },
      {
        "id": "password",
        "label": "Password",
        "source": "env:webtop-access:OPENSHIP_ADMIN_PASSWORD",
        "secret": true,
        "width": "half"
      }
    ],
    "firstLogin": {
      "note": "The generated credentials protect the gateway. Desktop sudo, terminal launchers and session sharing are disabled. The browser still has network access from its server."
    }
  },
  "files": [
    {
      "service": "webtop-access",
      "path": "/etc/workbox/access.sh",
      "content": "#!/bin/sh\nset -eu\nexport OPENSHIP_PASSWORD_HASH=\"$(caddy hash-password --plaintext \"$OPENSHIP_ADMIN_PASSWORD\")\"\nunset OPENSHIP_ADMIN_PASSWORD\nexec caddy run --config /etc/workbox/access.Caddyfile --adapter caddyfile\n"
    },
    {
      "service": "webtop-access",
      "path": "/etc/workbox/access.Caddyfile",
      "content": "{\n  auto_https off\n  admin off\n}\n:8080 {\n  basic_auth {\n    {$OPENSHIP_ADMIN_USER} {$OPENSHIP_PASSWORD_HASH}\n  }\n  reverse_proxy webtop:3000\n}\n"
    }
  ],
  "marketplace": {
    "features": [
      {
        "title": "Remote desktop",
        "description": "Use the browser visually with keyboard, mouse, audio and clipboard."
      },
      {
        "title": "Persistent profile",
        "description": "Project storage retains browser settings, profiles and files across redeployments."
      },
      {
        "title": "Protected access",
        "description": "Generated credentials, a private default endpoint and desktop hardening."
      }
    ],
    "articleFile": "articles/webtop.md"
  }
}

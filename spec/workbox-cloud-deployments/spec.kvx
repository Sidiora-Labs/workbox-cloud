[task.2.1]
title      = "Provider-neutral adapter contract and safety boundary"
status     = "planned"
wave       = 2
requires   = ["1.2"]
touches    = ["packages/platform/src/engine/modules/external-deployments/**", "packages/adapters/src/external/**", "packages/contracts/src/external-deployments.ts"]
